# Copiar a .env y completar valores.

JWT_SECRET=

# Correo del único usuario que puede: asignar empresas a otros usuarios y ejecutar
# POST /empresas/:id/asignar-data-existente. Debe coincidir con user.email en la BD.
# En el front, definir el mismo valor en VITE_MASTER_ADMIN_EMAIL (ver .env.example del front).
MASTER_ADMIN_EMAIL=

# Solo desarrollo: al arrancar la API, usuarios activos sin ninguna fila en user_empresas reciben la empresa por defecto.
# NO activar en producción si quieres que solo el admin principal asigne empresas.
# DEV_AUTO_ASSIGN_DEFAULT_COMPANY=true

# Opcional (solo desarrollo, ignora en production): usernames separados por coma → empresa por defecto al arrancar.
# DEV_ASSIGN_COMPANY_USERNAMES=Fercho,otro_user

# Solo si no hay ningún ADMIN: crea el primer usuario administrador (y le asigna la empresa por defecto).
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Contraseña para limpiezas destructivas en el front (misma cadena en el formulario).
# Usada en: vaciar pedidos/productos/cartera importados y vaciar tabla CPA (solo ADMIN).
# Sin esta variable esos endpoints responden 403.
IMPORT_WIPE_SECRET=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

PORT=3000

# Detrás de Apache/Nginx/Hostinger (producción): activar.
TRUST_PROXY=true

# Front permitido (URL exacta, sin barra final). Varios: separados por coma.
# Producción típica + localhost dashboard (5173) + portal admin principal (5174):
CORS_ORIGINS=https://pethostorefront.fersuastudio.com,http://localhost:5173,http://localhost:5174

# Zona horaria para filtros por rango de fechas (alinear con lo que ve el usuario en la UI).
# Por defecto America/Bogota. Ver: src/common/calendar-date-range.ts
# DATE_RANGE_TZ=America/Bogota

# Cómo interpretar columnas timestamp sin zona al filtrar por día:
# local (default) = la hora guardada es “reloj” en DATE_RANGE_TZ (imports con medianoche = día calendario).
# utc = el naive es instante UTC (si todo viene en UTC).
# DATE_RANGE_TS_STORE=local
