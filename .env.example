# Copiar a .env y completar valores.

JWT_SECRET=

# Contraseña para limpiezas destructivas en el front (misma cadena en el formulario).
# Usada en: vaciar pedidos/productos/cartera importados y vaciar tabla CPA (solo ADMIN).
# Sin esta variable esos endpoints responden 403.
IMPORT_WIPE_SECRET=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

PORT=3000

# Detrás de Apache/Nginx/Hostinger (producción): activar.
TRUST_PROXY=true

# Front permitido (URL exacta, sin barra final). Varios: separados por coma.
# Producción típica + opcional localhost para pruebas:
CORS_ORIGINS=https://pethostorefront.fersuastudio.com,http://localhost:5173

# Zona horaria para filtros por rango de fechas (alinear con lo que ve el usuario en la UI).
# Por defecto America/Bogota. Ver: src/common/calendar-date-range.ts
# DATE_RANGE_TZ=America/Bogota

# Cómo interpretar columnas timestamp sin zona al filtrar por día:
# local (default) = la hora guardada es “reloj” en DATE_RANGE_TZ (imports con medianoche = día calendario).
# utc = el naive es instante UTC (si todo viene en UTC).
# DATE_RANGE_TS_STORE=local
